
<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<div class="login-container">
  <h1><%= title %></h1>
  
  <div class="account-welcome">
    <h2>Welcome <%= accountData.account_firstname %></h2>
    <p>Logged in succesfully</p>
  </div>
</div>


