<header>
    <span id="siteName">
      <a href="/" title="Return to home page">
        <img src="/images/site/CSEMotors-logo.png" loading="lazy" alt="CSEMotors logo">
        </a>
    </span>
    <div id="tools">

      <% if(locals.loggedin) { %>
        <!-- Check this path: locals.accountData.account_firstname -->
        <a title="Click to access your account" href="/account/">Welcome <%= locals.accountData.account_firstname %>, </a>
        <a title="Click to Log out" href="/account/logout">Logout</a>
      <% } else { %>
        <a title="Click to log in" href="/account/login">My Account</a>
      <% } %>
    
    </div>
  </header>